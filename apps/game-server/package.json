{
  "name": "@prophecy/game-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter \"@prophecy/game-server^...\" build",
    "build": "tsc -p tsconfig.build.json",
    "dev": "NODE_OPTIONS='--conditions=development' tsx watch --env-file ../../.env src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1047.0",
    "@prophecy/game-engine": "workspace:*",
    "@prophecy/protocol": "workspace:*",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/sharp": "^0.32.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
