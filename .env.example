# --- shared ---
NODE_ENV=development

# --- database ---
DATABASE_URL=postgres://prophecy:prophecy@localhost:5432/prophecy

# --- redis ---
REDIS_URL=redis://localhost:6379

# --- object storage (R2 in prod, MinIO locally) ---
# S3_PUBLIC_URL is the public-read base URL for the bucket. Files are served at $S3_PUBLIC_URL/$key.
#   MinIO local:  http://localhost:9000/prophecy-assets  (set bucket policy to public in MinIO console)
#   Cloudflare R2: https://pub-<hash>.r2.dev  (or your custom domain after enabling public access)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=prophecy-assets
S3_ACCESS_KEY=prophecy
S3_SECRET_KEY=prophecy-dev-secret
S3_PUBLIC_URL=http://localhost:9000/prophecy-assets

# --- auth ---
AUTH_SECRET=replace-me-with-32-bytes-of-randomness
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- api ---
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000

# --- game-server ---
GAME_SERVER_PORT=3001
GAME_SERVER_PUBLIC_URL=http://localhost:3001

# --- web ---
# Leave unset in dev: the web client derives the api / game-server URL
# from window.location.hostname at runtime, so localhost and LAN-IP
# access both work without re-baking the bundle on every IP change.
# Set these only as an explicit production override (different host).
# VITE_API_URL=
# VITE_GAME_SERVER_URL=

# --- payments (leave blank for local) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- email ---
RESEND_API_KEY=

# --- observability ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
